% Figura a sangre en página horizontal (para el journey map completo).
% Se compone sin entorno flotante para que ocupe exactamente la página que le
% corresponde y no se desplace al final del documento.
\RequirePackage{pdflscape}
% Dentro de landscape la caja de texto ya viene intercambiada, de modo que
% \linewidth es el lado largo. El contenido se desborda un poco a propósito,
% centrado con \makebox, para aprovechar el margen de la página girada.
\newlength{\uxpanancho}
\newcommand{\figurapanoramica}[3]{%
  \begin{landscape}
  \thispagestyle{empty}
  % El ancho útil de la página girada es su altura física menos los márgenes.
  % Se calcula sobre \paperheight y no sobre \linewidth porque este último aún
  % no refleja la caja intercambiada al abrir el entorno. El margen adicional
  % reserva espacio para que el pie permanezca en la misma página que el mapa.
  \setlength{\uxpanancho}{\dimexpr\paperheight-5.0cm\relax}%
  \null\vfill
  \noindent\makebox[\linewidth][c]{%
    \includegraphics[width=\uxpanancho,keepaspectratio]{#1}}%
  \vspace{6pt}
  \noindent\makebox[\linewidth][c]{%
    \begin{minipage}{\uxpanancho}%
      \captionof{figure}{#2}\label{#3}%
    \end{minipage}}%
  \vfill
  \end{landscape}}

