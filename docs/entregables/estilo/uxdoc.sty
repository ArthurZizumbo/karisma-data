% -------------------------------------------------- Reparto de la página ---
% Por omisión LaTeX castiga las viudas y las huérfanas con solo 150, así que
% las admite con facilidad y deja páginas ocupadas por uno o dos renglones.
% Aquí quedan prohibidas: antes que una línea suelta, la página termina antes.
\widowpenalty=10000        % nada de una línea sola al principio de página
\clubpenalty=10000         % nada de una línea sola al final de página
\displaywidowpenalty=10000
\brokenpenalty=10000       % no parte una palabra entre dos páginas
\raggedbottom              % el sobrante se acumula al pie, sin estirar el texto

% Colocación de flotantes. Los valores de fábrica son restrictivos para un
% documento con tantas tablas y figuras como este: \textfraction=0.2 obliga a
% dejar una quinta parte de texto en cualquier página que lleve un flotante, de
% modo que una tabla algo grande se expulsa a una página propia y la anterior
% queda a medias. Con estos valores el flotante se queda donde lo pide el texto.
\renewcommand{\topfraction}{0.9}        % un flotante puede ocupar casi toda la parte alta
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.07}      % basta una franja de texto para compartir página
\renewcommand{\floatpagefraction}{0.75} % solo va a página propia si de veras la llena
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}

