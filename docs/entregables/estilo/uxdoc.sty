% titlesec ejecuta \<nivel>break antes de cada titular. Con las secciones
% fluyendo en la página (ya no todas abren con \clearpage), se exige sitio
% para el titular y las primeras líneas de su contenido: si no cabe, el salto
% de página ocurre antes del titular y nunca justo después.
\newcommand{\sectionbreak}{\needspace{8\baselineskip}}
\newcommand{\subsectionbreak}{\needspace{6\baselineskip}}
\newcommand{\subsubsectionbreak}{\needspace{5\baselineskip}}

% El índice hereda el \parskip del documento y a ese ritmo las últimas entradas
% caen en una página propia casi vacía. Dentro del índice el espacio entre
% entradas se reduce; las secciones conservan un \addvspace menor como
% separador de grupo, así que la jerarquía sigue leyéndose.
\let\ux@tableofcontents\tableofcontents
\renewcommand{\tableofcontents}{%
  \begingroup
  \setlength{\parskip}{1pt plus 1pt}%
  \ux@tableofcontents
  \endgroup}

% Copia de \l@section de article.cls con el colchón previo reducido de 1em a
% 0.7em: son los renglones que deciden si el índice cierra en la misma página.
\renewcommand*\l@section[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty\@secpenalty
    \addvspace{0.7em \@plus\p@}%
    \setlength\@tempdima{1.5em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode \bfseries
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil \nobreak\hb@xt@\@pnumwidth{\hss #2}\par
    \endgroup
  \fi}

% Titular sin numeración, con la misma presencia visual
\newcommand{\uxsection}[1]{%
  \section*{#1}\addcontentsline{toc}{section}{#1}%
  \vspace{-14pt}{\color{uxamber}\rule{\linewidth}{1.4pt}}\vspace{2pt}\par}

