% ------------------------------------------------- Mapa de empatía 2x2 ----
\newcommand{\ux@quad}[3]{%
  \begin{tcolorbox}[enhanced, colback=#1, colframe=#1, boxrule=0pt, arc=3pt,
      left=11pt, right=11pt, top=9pt, bottom=10pt, valign=top]
    {\uxhead\itshape\color{white}\fontsize{12.5}{15}\selectfont #2}\par\vspace{5pt}
    {\color{white}\footnotesize\setlength{\parskip}{0pt}%
     \begin{itemize}[label=\textcolor{white}{\tiny$\bullet$}, leftmargin=1em,
                     itemsep=4pt, topsep=1pt, parsep=0pt]#3\end{itemize}}%
  \end{tcolorbox}}

% \mapaempatia{nombre}{says}{thinks}{does}{feels} — cada cuadrante lleva sus \item
%
% El titular y la retícula viajan siempre juntos y en una sola página. La
% retícula se compone primero dentro de una caja para conocer su altura exacta,
% se reserva ese espacio —más el del titular— con \needspace y solo entonces se
% imprime: si no cabe, el salto ocurre antes del encabezado y el mapa entero
% pasa a la página siguiente. Al colocarse desde la caja, el tcbraster ya no
% ofrece punto de corte entre sus dos filas, que es por donde se partía.
\newsavebox{\ux@mapabox}
\newlength{\ux@mapatitular}
% Titular del mapa con su espacio: 16pt de \titlespacing antes, unos 17pt de
% caja del titular, 6pt después, 3pt de separación y 6pt de \parskip. Se redondea
% al alza para que la reserva nunca se quede corta.
\setlength{\ux@mapatitular}{56pt}
\newcommand{\mapaempatia}[5]{%
  \sbox{\ux@mapabox}{%
    \begin{minipage}[t]{\linewidth}%
      \setlength{\parskip}{0pt}%
      \begin{tcbraster}[raster columns=2, raster equal height=rows,
          raster column skip=7pt, raster row skip=7pt, raster left skip=0pt,
          raster right skip=0pt, raster before skip=0pt, raster after skip=0pt]
        \ux@quad{uxnavy}{Says}{#2}
        \ux@quad{uxsky}{Thinks}{#3}
        \ux@quad{uxsky}{Does}{#4}
        \ux@quad{uxnavy}{Feels}{#5}
      \end{tcbraster}%
    \end{minipage}}%
  \par
  \needspace{\dimexpr\ht\ux@mapabox+\dp\ux@mapabox+\ux@mapatitular\relax}%
  \subsection{Mapa de empatía de #1}%
  \par\nobreak\vspace{3pt}\nobreak
  \noindent\usebox{\ux@mapabox}%
  \par\addvspace{6pt}}

