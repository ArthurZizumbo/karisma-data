# Karisma Data — API. Plantilla versionada de variables de entorno.
# Copiala como backend/.env.local y completa los valores de desarrollo.
# Este archivo NUNCA lleva valores reales: en produccion los inyecta
# Secret Manager (US-003) y en local vive todo en .env.local, ignorado por git.

# --- Obligatorias -----------------------------------------------------------
# Sin cualquiera de las tres la aplicacion NO arranca (Pydantic Settings
# estricto, CA-8). No se relajan "para avanzar mas rapido".
#
# DATABASE_URL la consumen la API y tambien dbmate (make db-up). El sufijo
# ?sslmode=disable es OBLIGATORIO en local: el PostgreSQL del compose no sirve
# TLS y sin el sufijo dbmate aborta con "SSL is not enabled on the server".
# Forma esperada, identica a la de la seccion 9.6 del plan de la semana:
#   postgresql://<usuario>:<contrasena>@db:5432/karisma?sslmode=disable
# El host es "db" (nombre del servicio de Compose), no localhost.
DATABASE_URL=
JWT_SECRET_KEY=
GEMINI_API_KEY=

# --- Inicializacion del contenedor de PostgreSQL ----------------------------
# Las lee el servicio db de docker-compose.yml; la API las ignora.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Opcionales -------------------------------------------------------------
# Si faltan se usan los valores por defecto: local e INFO.
APP_ENV=local
LOG_LEVEL=INFO

# --- Acceso de demostracion (solo prototipo) --------------------------------
# DEMO_LOGIN_ENABLED enciende POST /api/auth/demo, que emite un token SIN
# credenciales para el usuario canonico de cada rol. Apagada la ruta no existe:
# 404 y ninguna entrada en /openapi.json.
#
# El valor por omision EN EL CODIGO es false (app/core/config.py), y ahi esta la
# proteccion: un entorno que olvide la variable queda cerrado. Esta plantilla la
# escribe en true porque describe una maquina de desarrollo, donde la puerta se
# quiere abierta: es la que usa el evaluador para entrar sin credenciales y la
# que se graba en las capturas de A4. Las dos cosas no se contradicen, y conviene
# leerlas juntas: lo deliberado no es escribir "true" aqui, es escribirlo en el
# --set-env-vars de un despliegue, donde nada lo pone por ti.
#
# El dia que el portal deje de servir datos sinteticos, se apaga.
DEMO_LOGIN_ENABLED=true

# KARISMA_DEMO_PASSWORD es la contrasena compartida de los siete usuarios
# sembrados. NO la lee la aplicacion: la consume unicamente
# scripts/generar_hashes_demo.py para producir los hashes argon2id de la
# migracion create_app_user y para verificarlos despues. Su valor real vive
# solo en backend/.env.local, que .gitignore excluye; aqui va vacia, como las
# tres obligatorias. No se despliega: no entra en Cloud Run ni en Secret
# Manager.
KARISMA_DEMO_PASSWORD=
