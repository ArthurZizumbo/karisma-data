%% ============================================================================
%%  uxdoc.sty — Sistema de diseño documental
%%  Equipo 8 · TC4032 Experiencia del usuario y diseño de interfaces · MNA ITESM
%%
%%  Tipografía y paleta derivadas del design system generado con ui-ux-pro-max
%%  ("enterprise data governance platform, professional, trustworthy"):
%%    · Titulares  Lexend Deca   (corporativo, confiable, alta legibilidad)
%%    · Cuerpo     Fira Sans     (humanista; sustituto disponible de Source Sans 3)
%%    · Color      azul corporativo + acento ámbar ajustado para contraste WCAG
%%
%%  Nota tipográfica: la familia Lexend se distribuye únicamente en peso Regular.
%%  Por eso los titulares NO usan \bfseries — que produciría negrita simulada — y
%%  la jerarquía se construye con tamaño, color y espacio en blanco.
%%
%%  Requiere XeLaTeX o LuaLaTeX.
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{uxdoc}[2026/08/02 v2.0 Sistema de diseno documental UX]
