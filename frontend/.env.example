# Destino del proxy de Nitro para /api/**.
#
# Este archivo describe el HOST: es el que lee "pnpm dev" cuando levantas el
# frontend en tu maquina, y ahi el backend responde en localhost:8000, que es
# el puerto que publica el contenedor api.
#
# Dentro de Docker Compose NO se usa este valor: docker-compose.yml lo fija en
# su bloque "environment" como http://api:8000 -el nombre del servicio-, y en
# Compose "environment" gana sobre "env_file". Por eso las dos formas de
# levantar el portal funcionan sin que tengas que acordarte de cambiar nada.
#
# Si escribes aqui "http://api:8000", el "pnpm dev" del host arranca y pinta la
# pantalla entera, pero toda llamada a la API muere: el nombre solo resuelve
# dentro de la red de Docker. El sintoma es un error de servidor al entrar, que
# no dice que la culpa sea de una variable.
NUXT_API_BASE=http://localhost:8000

# Rotulo de entorno que se muestra junto a la franja de alcance.
NUXT_PUBLIC_ENTORNO=local

# Muestra el selector de perfiles de demostracion en la pantalla de entrada.
# Solo decide lo que se ve: la puerta real es DEMO_LOGIN_ENABLED del backend,
# que ni siquiera monta la ruta cuando esta apagada. Se pone en false el dia que
# el portal deje de ser una demostracion evaluada.
NUXT_PUBLIC_DEMO_ACCESO=true
