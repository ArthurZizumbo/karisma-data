    {\color{white}\footnotesize\setlength{\parskip}{0pt}%
     \begin{itemize}[label=\textcolor{white}{\tiny$\bullet$}, leftmargin=1em,
                     itemsep=4pt, topsep=1pt, parsep=0pt]#3\end{itemize}}%
  \end{tcolorbox}}

% \mapaempatia{says}{thinks}{does}{feels} — cada argumento lleva sus \item
\newcommand{\mapaempatia}[4]{%
  \par\vspace{3pt}
  \begin{tcbraster}[raster columns=2, raster equal height=rows,
      raster column skip=7pt, raster row skip=7pt, raster left skip=0pt,
      raster right skip=0pt, raster before skip=2pt, raster after skip=6pt]
    \ux@quad{uxnavy}{Says}{#1}
    \ux@quad{uxsky}{Thinks}{#2}
    \ux@quad{uxsky}{Does}{#3}
    \ux@quad{uxnavy}{Feels}{#4}
  \end{tcbraster}}

