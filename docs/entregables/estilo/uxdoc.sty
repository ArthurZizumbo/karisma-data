% ------------------------------------------ Separador de parte (acumulado) --
% \uxparte{numeral}{título}{descripción} — portadilla de sección mayor para el
% documento acumulado que reúne varias actividades del curso.
\newcommand{\uxparte}[3]{%
  \clearpage
  \thispagestyle{empty}
  \null\vspace*{3.2cm}
  {\raggedright
   {\uxhead\fontsize{12}{15}\selectfont\color{uxmuted}PARTE #1}\par\vspace{10pt}
   {\uxhead\fontsize{26}{31}\selectfont\color{uxnavy}#2}\par\vspace{16pt}
   {\color{uxamber}\rule{90pt}{2.6pt}}\par\vspace{18pt}
   {\fontsize{11.5}{16}\selectfont\color{uxink}#3}\par}
  \clearpage}

% ------------------------------------------------ Lista de referencias ----
% Sangría francesa, consistente con la Actividad 1.
\newenvironment{uxreferencias}
  {\begingroup\setlength{\parskip}{9pt}\setlength{\parindent}{-0.5cm}\leftskip=0.5cm}
  {\endgroup}

% ------------------------------------------------------------- Figuras ----
% Ilustración de escena que acompaña a cada escenario
\newcommand{\figuraescena}[3]{%
  \begin{figure}[htbp]\centering
    \includegraphics[width=0.74\linewidth]{#1}
    \caption{#2}\label{#3}
  \end{figure}}

% El ancho es opcional y por omisión ocupa la caja de texto. Se declara solo
% cuando una figura muy alta se pasa del alto de página por unos puntos.
\newcommand{\figuraux}[4][\linewidth]{%
  \begin{figure}[htbp]\centering
    \includegraphics[width=#1]{#2}
    \caption{#3}\label{#4}
  \end{figure}}

% Figura a sangre en página horizontal (para el journey map completo).
% Se compone sin entorno flotante para que ocupe exactamente la página que le
% corresponde y no se desplace al final del documento.
\RequirePackage{pdflscape}
% Dentro de landscape la caja de texto ya viene intercambiada, de modo que
% \linewidth es el lado largo. El contenido se desborda un poco a propósito,
% centrado con \makebox, para aprovechar el margen de la página girada.
\newlength{\uxpanancho}
\newcommand{\figurapanoramica}[3]{%
  \begin{landscape}
  \thispagestyle{empty}
  % El ancho útil de la página girada es su altura física menos los márgenes.
  % Se calcula sobre \paperheight y no sobre \linewidth porque este último aún
  % no refleja la caja intercambiada al abrir el entorno. El margen adicional
  % reserva espacio para que el pie permanezca en la misma página que el mapa.
  \setlength{\uxpanancho}{\dimexpr\paperheight-5.0cm\relax}%
  \null\vfill
  \noindent\makebox[\linewidth][c]{%
    \includegraphics[width=\uxpanancho,keepaspectratio]{#1}}%
  \vspace{6pt}
  \noindent\makebox[\linewidth][c]{%
    \begin{minipage}{\uxpanancho}%
      \captionof{figure}{#2}\label{#3}%
    \end{minipage}}%
  \vfill
  \end{landscape}}

% ------------------------------------------------ Cabecera de escenario ---
% \escenariohead{foto}{título}{persona y perfil}{datos operativos}
\newcommand{\escenariohead}[4]{%
  \begin{tcolorbox}[enhanced, colback=uxsurface, colframe=uxline, boxrule=0.7pt,
      arc=4pt, left=12pt, right=12pt, top=12pt, bottom=12pt,
      before skip=4pt, after skip=10pt]
    \begin{minipage}[c]{2.5cm}%
      \begin{tcolorbox}[enhanced, colback=white, colframe=uxnavy, boxrule=1pt,
          arc=3pt, left=0pt, right=0pt, top=0pt, bottom=0pt, width=2.5cm]
        \includegraphics[width=\linewidth]{#1}%
      \end{tcolorbox}%
    \end{minipage}\hfill
    \begin{minipage}[c]{\dimexpr\linewidth-3.05cm\relax}%
      \setlength{\parskip}{0pt}%
      {\uxhead\fontsize{15}{18}\selectfont\color{uxnavy}#2}\par
      \vspace{7pt}
      {\color{uxamber}\rule{30pt}{2.2pt}}\par
      \vspace{7pt}
      {\footnotesize\color{uxink}\textbf{#3}}\par\vspace{3pt}
      {\footnotesize\color{uxmuted}#4}%
    \end{minipage}
  \end{tcolorbox}}

% Rótulo de los cuatro elementos exigidos por la rúbrica dentro del escenario
\newcommand{\elemento}[2]{%
  \par\vspace{10pt}\needspace{3\baselineskip}%
  {\uxhead\fontsize{12}{14}\selectfont\color{uxblue}#1}%
  {\footnotesize\color{uxmuted}\hspace{6pt}#2}%
  \par\vspace{2pt}}

