# Build context hygiene: nothing here reaches the image.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# No environment file travels inside the image: Compose injects them with
# env_file and Cloud Run with Secret Manager.
.env
.env.*
AGENTS.md
Dockerfile
.dockerignore
