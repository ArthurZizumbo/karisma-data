% ------------------------------------------------------------- Tablas -----
% L: ancho fijo alineado a la izquierda · C: ancho fijo centrado
% Y: columna elástica · Z{f}: columna elástica ponderada.
% Los factores de las columnas Z de una misma tabla deben sumar el número de
% columnas elásticas que contiene.
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{Z}[1]{>{\RaggedRight\arraybackslash\hsize=#1\hsize}X}
\newcommand{\thd}[1]{\textcolor{white}{\bfseries #1}}
\newcommand{\uxheadrow}{\rowcolor{uxnavy}}

% tabularx no admite partirse entre las mitades de \newenvironment: el cuerpo se
% captura completo con environ antes de pasarlo.
\NewEnviron{uxtabla}[2]% #1 = especificación de columnas, #2 = título
  {\begin{table}[htbp]\centering\footnotesize
   \setlength{\parskip}{0pt}%
   \caption{#2}%
   \rowcolors{2}{uxrow}{white}%
   \begin{tabularx}{\linewidth}{#1}\toprule
   \BODY
   \bottomrule\end{tabularx}\end{table}}

\captionsetup[table]{font={small,sf}, labelfont={bf,color=uxnavy},
  textfont={color=uxink}, skip=6pt, justification=raggedright, singlelinecheck=false}
\captionsetup[figure]{font={small,sf,it}, labelfont={bf,color=uxnavy},
  textfont={color=uxmuted}, skip=8pt, justification=raggedright, singlelinecheck=false}

