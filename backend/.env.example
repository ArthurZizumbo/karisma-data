# Karisma Data — API. Plantilla versionada de variables de entorno.
# Copiala como backend/.env.local y completa los valores de desarrollo.
# Este archivo NUNCA lleva valores reales: en produccion los inyecta
# Secret Manager (US-M01) y en local vive todo en .env.local, ignorado por git.

# --- Obligatorias -----------------------------------------------------------
# Sin cualquiera de las tres la aplicacion NO arranca (Pydantic Settings
# estricto, CA-8). No se relajan "para avanzar mas rapido".
#
# DATABASE_URL la consumen la API y tambien dbmate (make db-up). El sufijo
# ?sslmode=disable es OBLIGATORIO en local: el PostgreSQL del compose no sirve
# TLS y sin el sufijo dbmate aborta con "SSL is not enabled on the server".
# Forma esperada en local:
#   postgresql://<usuario>:<contrasena>@db:5432/karisma?sslmode=disable
# Forma esperada en Cloud Run con Cloud SQL (socket unix, US-M01):
#   postgresql://<usuario>:<contrasena>@/karisma?host=/cloudsql/tareas-computo-nube:us-central1:karisma-pg&sslmode=disable
DATABASE_URL=
JWT_SECRET_KEY=
GEMINI_API_KEY=

# --- Inicializacion del contenedor de PostgreSQL ----------------------------
# Las lee el servicio db de docker-compose.yml; la API las ignora.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Opcionales -------------------------------------------------------------
# Si faltan se usan los valores por defecto: local e INFO.
APP_ENV=local
LOG_LEVEL=INFO

# DATA_DIR es la raiz de solo lectura donde "make data" deja los silos
# sinteticos y la serie preagregada del tablero (data/aggregates/). Tiene valor
# por omision porque es una ruta y no un secreto: la regla estricta que hace
# obligatorias a las tres de arriba no se toca. En el contenedor api el compose
# monta ./data en /app/data:ro y el valor por omision ya apunta ahi.
DATA_DIR=data

# CHAT_PROVIDER elige quien responde POST /api/chat. HOY hay un unico valor
# que se puede servir: "guionizado", que reproduce el guion determinista de la
# demo -cadencia real, contenido escrito, cero red-.
#
# "gemini" esta declarado en el Literal de app/core/config.py pero NO tiene
# fabrica detras (app/services/proveedores/__init__.py). Escribirlo aqui no
# arranca una API que despues falle consulta por consulta: create_app() llama a
# verificar_proveedor_declarado() y la aplicacion se niega a arrancar, una vez y
# donde el despliegue lo ve. El Literal se queda mas ancho que la tabla a
# proposito, para que el dia del GO el unico cambio sea anadir la fabrica.
#
# El valor por omision EN EL CODIGO es "guionizado" (app/core/config.py) y ahi
# esta la proteccion: un entorno que olvide la variable sirve el asistente
# guionizado en vez de fallar al arrancar. Este ajuste NO vuelve obligatoria a
# GEMINI_API_KEY: encender "gemini" es una decision del go/no-go, no un efecto
# secundario de copiar la plantilla.
#
# Mientras valga "guionizado", la interfaz muestra una franja permanente que
# declara que la conversacion esta guionizada. La franja no se retira al
# cambiar de proveedor: cambia de texto.
CHAT_PROVIDER=guionizado

# --- Exportacion en segundo plano (US-009) ----------------------------------
# Los cuatro ajustes tienen valor por omision EN EL CODIGO (app/core/config.py)
# y ninguno puede impedir el arranque de quien nunca exporta. Esta plantilla los
# deja como estan por omision: solo se escriben cuando se quiere cambiarlos.
#
# EXPORT_STORAGE_BACKEND elige quien guarda el archivo producido y quien firma
# su enlace. Dos valores: "local" escribe en el sistema de archivos del
# contenedor y firma un enlace propio que esta misma API canjea; "gcs" sube el
# objeto a Cloud Storage y delega la firma en el bucket. El dia que exista el
# proyecto GCP, encender la nube es cambiar esta palabra, no reescribir codigo.
# Mientras tanto vale "local", que es lo unico que S4 ejecuta.
EXPORT_STORAGE_BACKEND=local

# EXPORT_SIGNING_KEY es la clave HMAC con la que se firma el enlace local. Es un
# secreto y por eso va VACIA aqui, igual que las tres obligatorias: su valor
# real vive en backend/.env.local y en produccion lo inyecta Secret Manager.
# Vacia no significa "sin firma": significa "derivala de JWT_SECRET_KEY", y la
# derivacion es un HMAC de una via con etiqueta propia, asi que quien obtenga
# esta clave no obtiene la que emite los tokens.
EXPORT_SIGNING_KEY=

# EXPORT_LINK_TTL_HOURS es la unica fuente de las 24 horas de vigencia del
# enlace. La comparten las dos implementaciones del almacen: bajarla aqui acorta
# la caducidad tanto del enlace firmado localmente como del de Cloud Storage.
EXPORT_LINK_TTL_HOURS=24

# EXPORT_DEMO_DELAY_SECONDS estira la duracion del trabajo REAL para que el
# estado "en proceso" dure lo bastante como para capturarlo con calma en A4. No
# falsifica ningun estado ni fabrica datos: el archivo que sale al final es el
# de verdad, solo tarda mas. En 0 -el valor por omision- no hay retraso alguno;
# en la maquina donde se toman las capturas se sube a 8. Mientras sea mayor que
# cero, la interfaz muestra la franja de honestidad que lo declara.
EXPORT_DEMO_DELAY_SECONDS=0

# --- Acceso de demostracion (solo prototipo) --------------------------------
# DEMO_LOGIN_ENABLED enciende POST /api/auth/demo, que emite un token SIN
# credenciales para el usuario canonico de cada rol. Apagada la ruta no existe:
# 404 y ninguna entrada en /openapi.json.
#
# El valor por omision EN EL CODIGO es false (app/core/config.py), y ahi esta la
# proteccion: un entorno que olvide la variable queda cerrado. Esta plantilla la
# escribe en true porque describe una maquina de desarrollo, donde la puerta se
# quiere abierta: es la que usa el evaluador para entrar sin credenciales y la
# que se graba en las capturas de A4. Las dos cosas no se contradicen, y conviene
# leerlas juntas: lo deliberado no es escribir "true" aqui, es escribirlo en el
# --set-env-vars de un despliegue, donde nada lo pone por ti.
#
# El dia que el portal deje de servir datos sinteticos, se apaga.
DEMO_LOGIN_ENABLED=true

# KARISMA_DEMO_PASSWORD es la contrasena compartida de los siete usuarios
# sembrados. NO la lee la aplicacion: la consume unicamente
# scripts/generar_hashes_demo.py para producir los hashes argon2id de la
# migracion create_app_user y para verificarlos despues. Su valor real vive
# solo en backend/.env.local, que .gitignore excluye; aqui va vacia, como las
# tres obligatorias. No se despliega: no entra en Cloud Run ni en Secret
# Manager.
KARISMA_DEMO_PASSWORD=
